# Python
host/.venv/
__pycache__/
*.pyc

# Vendored trade engine (fetched by scripts/setup.sh, pinned)
third_party/

# Local copy of the Gen 3 multiboot homebrew for the WebUI (not redistributed;
# fetched into third_party/ by scripts/setup.sh, copied to webui/ for serving)
webui/*.gba
# Generated from the (non-redistributed) homebrew for standalone multiboot
firmware/path-b-standalone/baked_gen3_mb.c

# Captured Pokémon are personal data; keep the folder, ignore contents
vault/*
!vault/.gitkeep

# Firmware build artifacts
firmware/**/build/
*.uf2
# keep the ready-to-flash binaries (inline comments are NOT allowed in gitignore)
!firmware/prebuilt/*.uf2

# Vendored bridge firmware (cloned + patched; reproducible per firmware/README.md)
firmware/path-a-build/
hardware/reference/game-boy-zero-link-board/
hardware/kicad/freerouting.jar
hardware/kicad/freerouting.log
hardware/kicad/*.dsn
hardware/kicad/*.ses
hardware/kicad/*.png
hardware/kicad/drc.rpt
hardware/kicad/*.kicad_prl
hardware/kicad/logs/
hardware/kicad/.history/
